\NeedsTeXFormat{LaTeX2e}[2021-06-01]
\ProvidesExplPackage{devicon}{2026-11-27}{0.2.2}
  {Devicon glyphs for pdfLaTeX, XeLaTeX and LuaLaTeX}

\RequirePackage{accsupp}

\msg_new:nnnn { devicon } { unsupported-engine }
  { The~devicon~package~requires~pdfLaTeX,~XeLaTeX~or~LuaLaTeX. }
  { Select~one~of~these~compilers~and~use~PDF~output~with~pdfLaTeX. }

\msg_new:nnnn { devicon } { missing-map }
  { The~generated~file~devicon-glyphs.def~is~missing. }
  { Copy~all~runtime~files~from~a~built~Devicon~for~LaTeX~release. }
\msg_new:nnnn { devicon } { unknown-icon }
  { Unknown~Devicon~font~icon~'#1'. }
  { Use~a~case-sensitive~name~listed~in~the~devicon~manual. }

\tl_new:N \l__devicon_name_tl
\tl_new:N \l__devicon_actualtext_tl
\str_new:N \l__devicon_actualtext_hex_str
\bool_new:N \l__devicon_artifact_bool
\keys_define:nn { devicon }
  {
    actualtext .tl_set:N = \l__devicon_actualtext_tl,
    actualtext .value_required:n = true,
    artifact .bool_set:N = \l__devicon_artifact_bool,
    artifact .default:n = true,
  }

\cs_new_protected:Npn \__devicon_declare:nnnn #1#2#3#4
  { \cs_new:cpn { __devicon_glyph_#1: } { \__devicon_glyph:nnn {#2} {#3} {#4} } }

\sys_if_engine_pdftex:TF
  {
    \int_compare:nNnF { \tex_pdfoutput:D } > { 0 }
      { \msg_fatal:nn { devicon } { unsupported-engine } }
    \tex_pdfmapfile:D { +devicon-pdftex.map }
    \cs_new_protected:Npn \__devicon_declare_bank:n #1
      {
        \DeclareFontFamily { U } {#1} { }
        \DeclareFontShape { U } {#1} { m } { n } { <-> #1 } { }
      }
    \cs_new_protected:Npn \__devicon_glyph:nnn #1#2#3
      {
        \usefont { U } {#2} { m } { n }
        \tex_char:D #3 \scan_stop:
      }
  }
  {
    \bool_lazy_or:nnF { \sys_if_engine_xetex_p: } { \sys_if_engine_luatex_p: }
      { \msg_fatal:nn { devicon } { unsupported-engine } }
    \RequirePackage{fontspec}
    \newfontfamily \__devicon_font: { devicon-2.18.0.ttf }
    \cs_new_eq:NN \__devicon_declare_bank:n \use_none:n
    \cs_new_protected:Npn \__devicon_glyph:nnn #1#2#3
      {
        \fontseries { m } \fontshape { n }
        \__devicon_font:
        \tex_char:D "#1 \scan_stop:
      }
  }

\file_if_exist:nTF { devicon-glyphs.def }
  { \file_input:n { devicon-glyphs.def } }
  { \msg_fatal:nn { devicon } { missing-map } }

\cs_new_protected:Npn \__devicon_untagged:nn #1#2
  {
    \str_set_convert:Nnnn \l__devicon_actualtext_hex_str {#1}
      { default } { utf16 / hex }
    \BeginAccSupp
      { method=hex, unicode=false, space=false, ActualText=\l__devicon_actualtext_hex_str }
    #2
    \EndAccSupp { }
  }

\cs_new_protected:Npn \__devicon_tagged:nn #1#2
  {
    \tag_mc_end_push:
    \bool_if:NTF \l__devicon_artifact_bool
      {
        \tag_mc_begin:n { artifact }
        #2
        \tag_mc_end:
      }
      {
        \tag_struct_begin:n { tag=Span }
        \tag_mc_begin:n { actualtext={#1} }
        #2
        \tag_mc_end:
        \tag_struct_end:
      }
    \tag_mc_begin_pop:n { }
  }

\cs_new_protected:Npn \__devicon_print:nn #1#2
  {
    \tl_set:Nx \l__devicon_name_tl { \tl_trim_spaces:n {#2} }
    \tl_set:Nx \l__devicon_name_tl { \tl_to_str:V \l__devicon_name_tl }
    \cs_if_exist:cF { __devicon_glyph_\l__devicon_name_tl : }
      { \regex_replace_once:nnN { \A devicon- } { } \l__devicon_name_tl }
    \cs_if_exist:cTF { __devicon_glyph_\l__devicon_name_tl : }
      {
        \mode_leave_vertical:
        \group_begin:
        \tl_set_eq:NN \l__devicon_actualtext_tl \l__devicon_name_tl
        \regex_replace_once:nnN { -(plain|original|line)(-wordmark)?\Z | -wordmark\Z }
          { } \l__devicon_actualtext_tl
        \regex_replace_all:nnN { [-_] } { \c{c_space_tl} } \l__devicon_actualtext_tl
        \tl_set:Nx \l__devicon_actualtext_tl { \l__devicon_actualtext_tl }
        \keys_set:nn { devicon } {#1}
        \tl_if_blank:VT \l__devicon_actualtext_tl { \bool_set_true:N \l__devicon_artifact_bool }
        \bool_if:NT \l__devicon_artifact_bool { \tl_clear:N \l__devicon_actualtext_tl }
        \bool_lazy_and:nnTF { \cs_if_exist_p:N \tag_if_active_p: } { \tag_if_active_p: }
          {
            \exp_args:NV \__devicon_tagged:nn \l__devicon_actualtext_tl
              { \hbox:n { \use:c { __devicon_glyph_\l__devicon_name_tl : } } }
          }
          {
            \hbox:n
              {
                \exp_args:NV \__devicon_untagged:nn \l__devicon_actualtext_tl
                  { \use:c { __devicon_glyph_\l__devicon_name_tl : } }
              }
          }
        \group_end:
      }
      { \msg_error:nnx { devicon } { unknown-icon } { \tl_to_str:n {#2} } }
  }

\NewDocumentCommand \devicon { O{} m } { \__devicon_print:nn {#1} {#2} }

% Skip both the key list and the icon name in PDF bookmarks.
\NewExpandableDocumentCommand \__devicon_bookmark:w { o m } { }
\AddToHook { package/hyperref/after } [ devicon ]
  { \pdfstringdefDisableCommands { \let\devicon\__devicon_bookmark:w } }

\endinput
